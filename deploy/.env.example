# Copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#
# `.env` is gitignored -- never commit real backend hostnames or secrets.

# URL of the MLflow tracking backend that the frontend proxies API calls to.
# Include the scheme and port, e.g. http://my-mlflow-host:5000
BACKEND_URL=http://CHANGE-ME:5000

# Port the UI is served on (used for both the host port and inside the container).
PORT=42069

# Optional: custom header logo. Place an image file in this deploy/ directory and set its
# filename here (PNG with transparency recommended). Leave empty to use the default MLflow logo.
# Example: LOGO_FILE=custom_logo.png
LOGO_FILE=
