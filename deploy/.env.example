# Copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#
# `.env` is gitignored -- never commit real backend hostnames or secrets.

# --- Backend: use one of these two options ---

# Option 1: run a local MLflow backend next to the frontend. DATA_DIR holds its database and
# artifacts; keep it somewhere you back up (e.g. /srv/mlflow-data or C:/Users/you/mlflow-data).
COMPOSE_PROFILES=backend
BACKEND_URL=http://mlflow-backend:5000
DATA_DIR=./data

# Option 2: proxy to an MLflow backend that's already running somewhere else. Remove the three lines
# above and set its URL here, including the scheme and port.
# BACKEND_URL=http://my-mlflow-host:5000

# --- Network ---

# Port the UI is served on (used for both the host port and inside the container).
PORT=42069

# Address the UI is published on. Nothing here requires a login, so the default only lets this
# machine connect; see "Reaching it from other machines" in README.md. Use 0.0.0.0 to open the port
# on every network interface.
BIND_ADDRESS=127.0.0.1

# Option 1 only: the URLs you reach the UI at, other than localhost, comma-separated, e.g.
# https://my-pc.my-tailnet.ts.net. Without this the backend rejects anything the UI tries to do from
# those URLs, including loading runs.
ALLOWED_ORIGINS=

# --- Appearance ---

# Optional: custom sidebar logo. Place an image file in this deploy/ directory and set its
# filename here (PNG with transparency recommended). Leave empty to use the default MLflow logo.
# Example: LOGO_FILE=custom_logo.png
LOGO_FILE=
